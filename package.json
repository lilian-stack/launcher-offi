{
  "name": "actoris-launcher",
  "version": "2.0.0",
  "description": "Launcher de jeux Electron pour la plateforme Actoris",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/inject-commit-hash.js && vite build",
    "build:analyze": "node scripts/inject-commit-hash.js && vite build --mode production && npx vite-bundle-visualizer",
    "preview": "vite preview",
    "start": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && node scripts/start-electron.js\"",
    "electron": "npx electron .",
    "electron:dev": "cross-env VITE_DEV_SERVER=true npx electron .",
    "bot:start": "node launcher-server.js",
    "bot:dev": "nodemon launcher-server.js",
    "clean": "if exist dist rmdir /s /q dist && if exist release rmdir /s /q release",
    "rebuild": "npm run clean && npm install && npm run build",
    "make:win": "npm run build && electron-builder --win",
    "make:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "build:setup:exe": "node scripts/build-setup-optimized.cjs",
    "build:setup": "node scripts/build-setup.js",
    "build:optimized": "node scripts/build-optimized.cjs && npm run build:setup",
    "clean:deps": "node scripts/remove-unused-deps.js",
    "postbuild:install-deps": "node scripts/postbuild-install-deps.js",
    "package:dev": "npm run build && electron-builder --win --x64 --dir",
    "export:github": "node scripts/utils/export-to-github.js",
    "test:sqlite": "node scripts/test-sqlite-library.js",
    "release": "node scripts/deploy/release-update.js",
    "check:security": "node scripts/check-security.js",
    "setup:7zip": "node scripts/setup-7zip.js",
    "check:space": "node scripts/check-launcher-space.js",
    "update:category": "node scripts/migrations/update-games-category.js",
    "add:category-column": "node scripts/migrations/add-category-column.js",
    "update:geometry-dash-lockr": "node scripts/utils/update-geometry-dash-lockr.js",
    "update:all-lockr-urls": "node scripts/utils/update-all-lockr-urls.js",
    "generate:all-lockr": "node scripts/utils/generate-all-missing-lockr.js",
    "check:missing-lockr": "node scripts/utils/check-and-create-missing-lockr.js",
    "update:all-lockr-casiers": "node scripts/utils/update-all-lockr-casiers.js",
    "test:integration": "node scripts/test-integration.js",
    "add:lockr-url-column": "node scripts/migrations/add-lockr-url-column.js",
    "update:all-games-unique-lockr": "node scripts/utils/update-all-games-unique-lockr.js",
    "update:unique-lockr-redirect": "node scripts/utils/update-unique-lockr-redirect.js",
    "setup:env": "node scripts/setup-env-install.js",
    "benchmark": "node scripts/benchmark-setup.js",
    "config:auto": "node scripts/auto-config-deps.js",
    "config:backup": "node scripts/backup-config.js create",
    "config:restore": "node scripts/backup-config.js restore",
    "config:list": "node scripts/backup-config.js list",
    "diagnose:backend": "node scripts/diagnose-backend.js",
    "migrate:lockr": "node scripts/migrations/migrate-lockr-to-table.js",
    "setup:redirect-tokens": "node scripts/setup-redirect-tokens.js",
    "deploy:vercel": "node scripts/deploy/deploy-vercel-minimal.js",
    "prepare:vercel": "node scripts/deploy/prepare-vercel-deploy.js",
    "rebuild:electron": "electron-rebuild",
    "rebuild:sqlite": "npx electron-rebuild -f -w better-sqlite3",
    "migrate:sqlite": "node scripts/migrate-games-to-sqlite.mjs",
    "postinstall": "node scripts/auto-config-deps.js && npx electron-rebuild",
    "measure:start": "node scripts/scan-deps.js && echo \"Run Electron to collect startup metrics (startup-metrics.json)\"",
    "scan:deps": "node scripts/scan-deps.js",
    "optimize:assets": "node scripts/optimize-assets.js",
    "prune:suggest": "node scripts/suggest-prune-deps.js",
    "update:check": "node scripts/check-commit-updates.js",
    "update:deploy": "node scripts/deploy-commit-update.js",
    "start:production": "cross-env NODE_ENV=production npm run electron",
    "build:production": "npm run clean && node scripts/inject-commit-hash.js && vite build --mode production",
    "package:production": "npm run build:production && electron-builder --win --x64",
    "clean:production": "node scripts/clean-for-production.js",
    "optimize:all": "node scripts/optimize-production.js",
    "security:audit": "node scripts/security-audit.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "7zip-bin": "^5.2.0",
    "atomically": "^2.1.0",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.5.0",
    "body-parser": "^2.2.1",
    "cheerio": "^1.1.2",
    "compression": "^1.7.4",
    "conf": "^11.0.2",
    "cors": "^2.8.5",
    "debug": "^4.3.4",
    "depd": "^2.0.0",
    "discord-rpc": "^4.0.1",
    "discord.js": "^14.14.1",
    "dot-prop": "^10.1.0",
    "dotenv": "^17.2.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.6.2",
    "encodeurl": "^2.0.0",
    "env-paths": "^3.0.0",
    "escape-html": "^1.0.3",
    "express": "^4.18.2",
    "finalhandler": "^2.1.1",
    "framer-motion": "^12.23.26",
    "jsonwebtoken": "^9.0.2",
    "keytar": "^7.9.0",
    "lodash.defaultsdeep": "^4.6.1",
    "lodash.defaultto": "^4.14.0",
    "lodash.flattendeep": "^4.4.0",
    "lodash.isempty": "^4.4.0",
    "lodash.isplainobject": "^4.0.6",
    "lodash.isstring": "^4.0.1",
    "lodash.negate": "^3.0.2",
    "merge-descriptors": "^2.0.0",
    "ms": "^2.1.3",
    "node-7z": "^3.0.0",
    "node-fetch": "^2.7.0",
    "normalize-path": "^3.0.0",
    "puppeteer": "^24.34.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-window": "^2.2.3",
    "react-window-infinite-loader": "^2.0.0",
    "sharp": "^0.34.5",
    "tr46": "^6.0.0",
    "webidl-conversions": "^8.0.0",
    "whatwg-url": "^15.1.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "lightningcss": "^1.30.2",
    "nodemon": "^3.0.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "terser": "^5.26.0",
    "vite": "^5.0.11",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.actoris.launcher",
    "productName": "Actoris",
    "asar": true,
    "compression": "maximum",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "launcher-server.js",
      "server/**/*",
      "resources/7zip/**/*",
      "!**/*.map",
      "!**/*.ts",
      "!node_modules/**/*",
      "!**/node_modules/discord.js/locales/**",
      "!**/node_modules/**/locale/**",
      "node_modules/axios/**/*",
      "node_modules/discord-rpc/**/*",
      "node_modules/ws/**/*",
      "node_modules/decompress/**/*",
      "node_modules/decompress-tarbz2/**/*",
      "node_modules/decompress-targz/**/*",
      "node_modules/decompress-unzip/**/*",
      "node_modules/node-7z/**/*",
      "node_modules/7zip-bin/win/x64/**/*",
      "node_modules/express/**/*",
      "node_modules/finalhandler/**/*",
      "node_modules/on-finished/**/*",
      "node_modules/encodeurl/**/*",
      "node_modules/escape-html/**/*",
      "node_modules/merge-descriptors/**/*",
      "node_modules/discord.js/**/*",
      "node_modules/cheerio/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/cors/**/*",
      "node_modules/keytar/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/body-parser/**/*",
      "node_modules/debug/**/*",
      "node_modules/conf/**/*",
      "node_modules/ms/**/*",
      "node_modules/depd/**/*",
      "node_modules/dot-prop/**/*",
      "node_modules/env-paths/**/*",
      "node_modules/atomically/**/*",
      "node_modules/lodash.defaultto/**/*",
      "node_modules/lodash.flattendeep/**/*",
      "node_modules/lodash.defaultsdeep/**/*",
      "node_modules/lodash.isempty/**/*",
      "node_modules/lodash.negate/**/*",
      "node_modules/lodash/**/*",
      "node_modules/normalize-path/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "extraFiles": [
        {
          "from": "launcher-server.js",
          "to": "launcher-server.js"
        },
        {
          "from": "electron/discord-service-secure.mjs",
          "to": "discord-service-secure.mjs"
        },
        {
          "from": "electron/discord-config.mjs",
          "to": "discord-config.mjs"
        },
        {
          "from": "electron/discord-rpc-service.mjs",
          "to": "discord-rpc-service.mjs"
        },
        {
          "from": "electron/utils/env-manager.mjs",
          "to": "env-manager.mjs"
        },
        {
          "from": "electron/game-extractor.mjs",
          "to": "game-extractor.mjs"
        },
        {
          "from": "electron/utils/config.mjs",
          "to": "config.mjs"
        },
        {
          "from": "electron/utils/secure-config.mjs",
          "to": "secure-config.mjs"
        },
        {
          "from": "electron/utils/logger.mjs",
          "to": "logger.mjs"
        },
        {
          "from": "electron/games-service.mjs",
          "to": "games-service.mjs"
        },
        {
          "from": "electron/supabase-games-service.mjs",
          "to": "supabase-games-service.mjs"
        },
        {
          "from": "electron/supabase-config.mjs",
          "to": "supabase-config.mjs"
        },
        {
          "from": "electron/simple-store.mjs",
          "to": "simple-store.mjs"
        },
        {
          "from": "electron/discord-webhook-service.mjs",
          "to": "discord-webhook-service.mjs"
        },
        {
          "from": "electron/steam-service.mjs",
          "to": "steam-service.mjs"
        },
        {
          "from": "electron/supabase-users-service.mjs",
          "to": "supabase-users-service.mjs"
        },
        {
          "from": "electron/supabase-secrets-service.mjs",
          "to": "supabase-secrets-service.mjs"
        },
        {
          "from": "electron/supabase-config.mjs",
          "to": "supabase-config.mjs"
        },
        {
          "from": "resources/7zip",
          "to": "resources/7zip"
        },
        {
          "from": "server",
          "to": "server"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Actoris",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "menuCategory": "Games",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "warningsAsErrors": false,
      "differentialPackage": false
    },
    "afterPack": "scripts/after-pack.cjs",
    "asarUnpack": [
      "node_modules/.bin/**/*",
      "launcher-server.js",
      "server/**/*",
      "node_modules/7zip-bin/win/x64/**/*",
      "!node_modules/7zip-bin/linux/**/*",
      "!node_modules/7zip-bin/mac/**/*",
      "!node_modules/7zip-bin/arm/**/*",
      "!node_modules/7zip-bin/arm64/**/*",
      "!node_modules/7zip-bin/ia32/**/*",
      "node_modules/node-7z/**/*",
      "node_modules/express/**/*",
      "node_modules/ws/**/*",
      "node_modules/discord.js/**/*",
      "node_modules/cheerio/**/*",
      "node_modules/dotenv/**/*",
      "node_modules/cors/**/*",
      "node_modules/axios/**/*",
      "node_modules/@supabase/supabase-js/**/*",
      "node_modules/electron-store/**/*",
      "node_modules/body-parser/**/*",
      "node_modules/debug/**/*",
      "node_modules/conf/**/*",
      "node_modules/ms/**/*",
      "node_modules/depd/**/*",
      "node_modules/merge-descriptors/**/*",
      "node_modules/dot-prop/**/*",
      "node_modules/lodash.defaultto/**/*",
      "node_modules/lodash.flattendeep/**/*",
      "node_modules/lodash.defaultsdeep/**/*",
      "node_modules/lodash.isempty/**/*",
      "node_modules/lodash.negate/**/*",
      "node_modules/lodash.isplainobject/**/*",
      "node_modules/lodash.isstring/**/*",
      "node_modules/lodash/**/*",
      "node_modules/normalize-path/**/*",
      "node_modules/finalhandler/**/*",
      "node_modules/on-finished/**/*",
      "node_modules/env-paths/**/*",
      "node_modules/atomically/**/*",
      "node_modules/keytar/**/*",
      "electron/installed-games-store.js"
    ]
  }
}